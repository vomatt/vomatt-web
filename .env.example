# Copy to .env.local for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables. See README.md for details.

# ── Sanity (CMS content: site settings, pages, coming-soon switch) ──────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── vomatt-api (polls, auth, users) ─────────────────────────────────────────
# Origin only: no path, no trailing slash
API_URL=http://localhost:8080
# API request/response log: on in `npm run dev` (0 hides it), off in deployments
# unless 1 (e.g. Vercel Preview scoped to the `dev` branch → Runtime Logs)
# API_LOG=0
# Must be the exact value of the API's JWT_SECRET (≥32 characters)
SESSION_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin of this site, no trailing slash. Required: metadata and canonical URLs use it.
SITE_URL=http://localhost:3002
